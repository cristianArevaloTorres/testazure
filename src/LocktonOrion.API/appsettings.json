{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=LocktonOrionDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_SECURE_SECRET_FROM_KEY_VAULT",
    "Issuer": "lockton-orion-api",
    "Audience": "lockton-orion-client",
    "ExpiryMinutes": "15"
  },
  "Encryption": {
    "AesKey": "REPLACE_WITH_32_BYTE_BASE64_KEY_FROM_KEY_VAULT"
  },
  "AzureServiceBus": {
    "ConnectionString": "REPLACE_WITH_SERVICE_BUS_CONNECTION_FROM_KEY_VAULT",
    "QuotationRequestsTopic": "quotation-requests",
    "QuotationResultsTopic": "quotation-results",
    "NotificationsQueue": "notifications"
  },
  "Anthropic": {
    "ApiKey": "REPLACE_WITH_CLAUDE_API_KEY_FROM_KEY_VAULT",
    "DefaultModel": "claude-3-5-sonnet-20241022",
    "MaxTokens": 1024
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.locktonorion.com"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "REPLACE_WITH_APPINSIGHTS_CONNECTION_STRING"
  },
  "AllowedHosts": "*"
}
